/// AcceptorPoolSupervisor — `numAcceptors` `AcceptorSupervisor`s with the
/// integer ids `1..numAcceptors`, as Thousand Island's
/// `ThousandIsland.AcceptorPoolSupervisor` (which ids them
/// `"acceptor-N"`). Integer ids mint no atoms.
///
/// Args: `#server` (the `ServerSupervisor`) and `#config`.
typed Supervisor subclass: AcceptorPoolSupervisor

  childSpecs -> List(SupervisionSpec) =>
    server :: ServerSupervisor := self args at: #server
    config :: ServerConfig := self args at: #config
    // `do:`, not `collect:`, over the Interval: its `collect:` block
    // parameter is untyped (BT-4040).
    specs := #()
    (1 to: config numAcceptors)
      do: [:i |
        specs := specs
          add: (AcceptorSupervisor supervisionSpec withId: i withArgs: #{
            #id => i,
            #server => server,
            #config => config
          })
      ]
    specs
