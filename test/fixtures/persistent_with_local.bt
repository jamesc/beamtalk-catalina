/// `PersistentTimeoutWithLocalMessages` (`startsWith:`, see
/// `PersistentTimeoutData`): "start" sets a persistent 80 ms
/// timeout; local messages keep arriving.
RecordingHandler subclass: PersistentWithLocal

  handleData: data :: Object socket: _sock :: Socket state: st :: Object -> HandlerResult =>
    text := HandlerHarness textOf: data
    self scheduleLocal
    (text startsWith: "start") ifTrue: [
      HandlerResult continue: st persistentTimeout: 80
    ] ifFalse: [HandlerResult continue: st]

  handleUserInfo: msg :: Object -> Object =>
    msg =:= #localMessage ifTrue: [self scheduleLocal]

  scheduleLocal -> Object =>
    Timer
      send: #localMessage
      to: self
      after: 10
