/// ServerConfig — the configuration of one Catalina server, as Thousand
/// Island's `ThousandIsland.ServerConfig`. The options and their defaults
/// are Thousand Island's, in camelCase:
///
/// | Option | Default | Thousand Island |
/// |---|---|---|
/// | `port` | `4000` | `port` |
/// | `transport` | `TCPTransport` | `transport_module` |
/// | `transportOptions` | `#()` | `transport_options` |
/// | `handler` | none, required | `handler_module` |
/// | `handlerOptions` | `#()` | `handler_options` |
/// | `genServerOptions` | `#()` | `genserver_options` |
/// | `supervisorOptions` | `#()` | `supervisor_options` |
/// | `numAcceptors` | `100` | `num_acceptors` |
/// | `numListenSockets` | `1` | `num_listen_sockets` |
/// | `numConnections` | `16384` (or `#infinity`) | `num_connections` |
/// | `maxConnectionsRetryCount` | `5` | `max_connections_retry_count` |
/// | `maxConnectionsRetryWait` | `1000` | `max_connections_retry_wait` |
/// | `readTimeout` | `60000` (or `#infinity`) | `read_timeout` |
/// | `handshakeTimeout` | `5000` (or `#infinity`) | `handshake_timeout` |
/// | `shutdownTimeout` | `15000` (or `#infinity`) | `shutdown_timeout` |
/// | `silentTerminateOnError` | `false` | `silent_terminate_on_error` |
///
/// Build one with `fromOptions:`, which validates the options as
/// `ServerConfig.new/1` does. (`new:` is sealed on `Value`, so the
/// validating constructor has its own name.)
///
/// `transportOptions` and `supervisorOptions` take a Dictionary, such as
/// `#{#reuseport => true, #certfile => "cert.pem"}`, or a List, which is
/// passed through as a raw Erlang proplist. Thousand Island takes keyword
/// lists here; Catalina prefers a Dictionary, as for its other options.
/// `fromOptions:` turns a Dictionary into a proplist once, so the accessors
/// always answer a List: `#key => value` becomes `{key, value}`. The
/// atom-only listen options (`binary`, `list`, `inet`, `inet6` and `local`;
/// see `atomOptions`) become the bare atom for `true` and are left out for
/// `false`. A Dictionary has no order, so use a List when the order of the
/// options matters.
///
/// ## Examples
/// ```beamtalk
/// config := ServerConfig fromOptions: #{#port => 0, #handler => Object}
/// config numAcceptors   // => 100
/// ```
sealed typed Value subclass: ServerConfig
  field: port :: Integer = 4000
  // Any class conforming to `Transport`; a protocol's class side has no type
  // name, so it is Dynamic.
  field: transport :: Dynamic = TCPTransport
  field: transportOptions :: List(Symbol | Tuple) = #()
  field: handler :: Handler class | Nil = nil
  field: handlerOptions :: Object = #()
  field: genServerOptions :: List(Symbol | Tuple) = #()
  field: supervisorOptions :: List(Symbol | Tuple) = #()
  field: numAcceptors :: Integer = 100
  field: numListenSockets :: Integer = 1
  // `Integer | #infinity` rather than the `Timeout` alias, whose Integer
  // defaults are rejected (BT-4039).
  field: numConnections :: Integer | #infinity = 16384
  field: maxConnectionsRetryCount :: Integer = 5
  field: maxConnectionsRetryWait :: Integer = 1000
  field: readTimeout :: Integer | #infinity = 60000
  field: handshakeTimeout :: Integer | #infinity = 5000
  field: shutdownTimeout :: Integer | #infinity = 15000
  field: silentTerminateOnError :: Boolean = false

  /// A validated configuration from a Dictionary of options. Raises on an
  /// unknown option, a missing `handler`, `transportOptions` or
  /// `supervisorOptions` that are not a valid Dictionary or a List, more
  /// listen sockets than acceptors, or several listen sockets without
  /// `reuseport` or `reuseport_lb` in `transportOptions`.
  class sealed fromOptions: options :: Dictionary(Symbol, Object) -> ServerConfig =>
    self validateKeys: options
    config := self new: (self normaliseOptions: options)
    self validateHandler: config
    self validateNumSockets: config
    self validateReuseport: config
    config

  /// The option names `fromOptions:` accepts, as Bandit reads
  /// `ThousandIsland.ServerConfig.__struct__()` to split its options from
  /// Thousand Island's.
  class sealed optionNames -> List(Symbol) => self new fieldNames

  /// `new:` does not reject undeclared keys at runtime (BT-4030), and an
  /// unknown option is a typo the user should hear about, as Elixir's
  /// `struct!/2` reports it.
  class sealed validateKeys: options :: Dictionary(Symbol, Object) -> Nil =>
    known := self optionNames
    options keys
      do: [:key |
        (known includes: key) ifFalse: [
          Error signal: "Unknown server option: " ++ key printString
        ]
      ]
    nil

  /// The `gen_tcp` and `ssl` listen options that are a bare atom rather
  /// than a `{key, value}` pair (OTP 27 and 28): the `list` or `binary`
  /// mode, and the `inet`, `inet6` or `local` address family.
  class sealed atomOptions -> List(Symbol) =>
    #(#binary, #list, #inet, #inet6, #local)

  /// `options` with `transportOptions` and `supervisorOptions` as proplists.
  class sealed normaliseOptions: options :: Dictionary(Symbol, Object) -> Dictionary(Symbol, Object) =>
    #(#transportOptions, #supervisorOptions)
      inject: options
      into: [:acc :name |
        (options includesKey: name) ifTrue: [
          acc at: name put: (self proplist: (options at: name) named: name)
        ] ifFalse: [acc]
      ]

  class sealed proplist: value :: Object named: name :: Symbol -> List(Symbol | Tuple) =>
    (value isKindOf: List) ifTrue: [^value]
    (value isKindOf: Dictionary)
      ifFalse: [
        Error signal: "{name} must be a Dictionary or a List, got: {value printString}"
      ]
    value keys
      inject: #()
      into: [:acc :key |
        acc ++ (self
          entry: key
          value: (value at: key)
          named: name)
      ]

  /// The proplist entries for one Dictionary entry: none, a bare atom, or
  /// a `{key, value}` pair.
  class sealed entry: key :: Object value: value :: Object named: name :: Symbol -> List(Symbol | Tuple) =>
    (key isKindOf: Symbol) ifFalse: [
      Error signal: "{name} keys must be Symbols, got: {key printString}"
    ]
    (self atomOptions includes: key) ifFalse: [^#() add: {key, value}]
    value =:= true ifTrue: [^#() add: key]
    value =:= false ifTrue: [^#()]
    Error signal: "{name} option {key printString} must be true or false, got: {value printString}"

  class sealed validateHandler: config :: ServerConfig -> Nil =>
    config handler isNil ifTrue: [
      Error signal: "No handler defined in server configuration"
    ]
    nil

  class sealed validateNumSockets: config :: ServerConfig -> Nil =>
    config numListenSockets > config numAcceptors
      ifTrue: [
        Error signal: "numListenSockets ({config numListenSockets}) must be less than or equal to numAcceptors ({config numAcceptors})"
      ]
    nil

  class sealed validateReuseport: config :: ServerConfig -> Nil =>
    opts := config transportOptions
    reuseport := (Erlang proplists
      get_value: #reuseport
      with: opts
      with: false) =:= true
    reuseportLb := (Erlang proplists
      get_value: #reuseport_lb
      with: opts
      with: false) =:= true
    (config numListenSockets <= 1 or: [reuseport or: [reuseportLb]])
      ifFalse: [
        Error signal: "reuseport or reuseport_lb must be set in transportOptions when numListenSockets > 1"
      ]
    nil
