/// Spike 6 (PLAN.md Phase 0): rough cost of the `handleInfo:` round trip
/// per packet. 10k one-byte request/response round trips over loopback,
/// through `ActiveOnceEcho` (`{tcp, ...}` in `handleInfo:`, echo, re-arm)
/// and, as a baseline, through a passive socket echoed by the test process
/// itself. Both make the same four socket calls through the FFI, so the
/// difference is roughly what the Server path adds per packet.
///
/// Two more numbers separate the parts: `handle_info_ns_per_message` is the
/// server handling 10k queued raw messages (no socket, no FFI), and
/// `sender_ns_per_message` is the cost of one inline FFI call
/// (`Erlang erlang send:msg:`) in the sending loop.
///
/// Results go to `_build/spikes/echo_bench.txt`; the assertion is only a
/// loose sanity bound, so the numbers are informational.
TestCase subclass: EchoBenchSpikeTest

  rounds => 10000

  socketPair =>
    ls := ((Erlang gen_tcp) listen: 0 with: #(#binary, {#active, false}, {#reuseaddr, true}, {#nodelay, true})) unwrap
    port := ((Erlang inet) port: ls) unwrap
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#active, false}, {#nodelay, true})) unwrap
    server := ((Erlang gen_tcp) accept: ls with: 1000) unwrap
    (Erlang gen_tcp) close: ls
    {client, server}

  micros => Erlang erlang monotonic_time: #microsecond

  /// Microseconds for `rounds` round trips through an ActiveOnceEcho.
  serverEcho =>
    {client, serverSock} := self socketPair
    echo := ActiveOnceEcho spawn
    ((Erlang gen_tcp) controlling_process: serverSock with: echo pid) unwrap
    echo own: serverSock
    started := self micros
    self rounds
      timesRepeat: [
        (Erlang gen_tcp) send: client with: "x"
        (Erlang gen_tcp)
          recv: client
          with: 0
          with: 1000
      ]
    elapsed := self micros - started
    self assert: echo packets equals: self rounds
    echo stop
    (Erlang gen_tcp) close: client
    elapsed

  /// Microseconds for `rounds` round trips echoed by this process from a
  /// passive socket: the same four socket calls, no actor in the path.
  passiveEcho =>
    {client, serverSock} := self socketPair
    started := self micros
    self rounds
      timesRepeat: [
        (Erlang gen_tcp) send: client with: "x"
        data := ((Erlang gen_tcp)
          recv: serverSock
          with: 0
          with: 1000) unwrap
        (Erlang gen_tcp) send: serverSock with: data
        (Erlang gen_tcp)
          recv: client
          with: 0
          with: 1000
      ]
    elapsed := self micros - started
    (Erlang gen_tcp) close: client
    (Erlang gen_tcp) close: serverSock
    elapsed

  /// Microseconds for `rounds` raw messages dispatched through
  /// `handleInfo:` (match on a tuple, update state), with no socket: stale
  /// `{read_timeout, Ref}` messages to a ReadTimeoutServer. The server is
  /// suspended while they are queued, so only its handling is timed, from
  /// `sys:resume` to the reply of a call queued behind them. Answers
  /// `{handling, sending}`; `sending` is the sender's FFI loop on its own.
  handleInfoDispatch =>
    s := ReadTimeoutServer spawn
    ref := Erlang erlang make_ref
    pid := s pid
    (Erlang sys) suspend: pid
    sendStarted := self micros
    self rounds timesRepeat: [Erlang erlang send: pid msg: {#read_timeout, ref}]
    sending := self micros - sendStarted
    started := self micros
    (Erlang sys) resume: pid
    self assert: s stale equals: self rounds
    handling := self micros - started
    s stop
    {handling, sending}

  testEchoTenThousandPackets =>
    // Warm up both paths once so code loading is not measured.
    self serverEcho
    self passiveEcho
    self handleInfoDispatch
    server := self serverEcho
    passive := self passiveEcho
    {dispatch, sendLoop} := self handleInfoDispatch
    // Nanoseconds per round trip, as integers.
    perServer := server * 1000 div: self rounds
    perPassive := passive * 1000 div: self rounds
    report := "rounds={self rounds} server_total_us={server} server_ns_per_packet={perServer} passive_total_us={passive} passive_ns_per_packet={perPassive} overhead_ns_per_packet={perServer - perPassive} handle_info_ns_per_message={dispatch * 1000 div: self rounds} sender_ns_per_message={sendLoop * 1000 div: self rounds}"
    File mkdirAll: "_build/spikes"
    File writeAll: "_build/spikes/echo_bench.txt" contents: report
    // Loose sanity bound only: a millisecond per loopback round trip.
    self assert: perServer < 1000000
