/// `HandleConnection.UpgradeError`: TCP cannot be upgraded, so the
/// upgrade fails and `handleError:` gets `#unsupported_upgrade`.
RecordingHandler subclass: UpgradeError

  handleConnection: sock :: Socket state: st :: Object -> HandlerResult =>
    sock send: "HELLO"
    HandlerResult
      switchTransport: TCPTransport
      options: #()
      state: st
