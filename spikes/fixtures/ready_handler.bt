/// Spike 2: a handler that records the order its messages arrive in. It
/// arms `{active, once}` only once the ready message has arrived.
Server subclass: ReadyHandler
  state: sock = nil
  state: log = #()

  handleInfo: msg =>
    msg match: [
      {#catalina_ready, s} -> self onReady: s;
      {#tcp, _s, data} -> self onData: data;
      _ -> nil
    ]

  onReady: aSocket =>
    self.log := self.log add: #ready
    self.sock := aSocket
    (Erlang inet) setopts: aSocket with: #({#active, #once})

  onData: data =>
    self.log := self.log add: data
    self.sock isNil ifFalse: [
      (Erlang inet) setopts: self.sock with: #({#active, #once})
    ]

  log => self.log
