/// ConnectionSupervisor — the handler processes one acceptor has started,
/// as the `DynamicSupervisor` in Thousand Island's
/// `ThousandIsland.AcceptorSupervisor`.
///
/// Its child class is the server's `handler`, at most `numConnections` of
/// them, each given `shutdownTimeout` to stop. Handlers are `#temporary`:
/// a connection that ends is not restarted.
///
/// Args: the server's `ServerConfig`.
typed DynamicSupervisor(Handler) subclass: ConnectionSupervisor

  childClass -> Class => self config handler

  maxChildren -> Integer | Symbol => self config numConnections

  childShutdown -> ShutdownTimeout | Nil => self config shutdownTimeout

  /// The server's configuration (the start args).
  config -> ServerConfig => self args
