/// `LongGenServerCallbacksHaveAContinuationEscapeHatch`: a slow message
/// handler resets the read timeout with `handleContinuation:`.
RecordingHandler subclass: SlowUserInfoEscape

  handleConnection: _sock :: Socket state: st :: Object -> HandlerResult =>
    self pid send: #sleepThenSend
    HandlerResult continue: st

  handleUserInfo: msg :: Object -> Object =>
    msg match: [
      #sleepThenSend -> self sleepThenSend;
      #sendBytes -> self socket send: "A";
      _ -> nil
    ]

  sleepThenSend -> Object =>
    Timer sleep: 150
    Timer
      send: #sendBytes
      to: self
      after: 50
    self handleContinuation: (HandlerResult continue: self userState)
