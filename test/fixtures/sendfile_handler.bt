/// Owns a connection and sends a whole file down it, as the
/// `LargeSendfile` handler in `socket_test.exs` does. It runs in its own
/// process so the test process can read while it sends.
typed Actor subclass: SendfileHandler
  // Set once by `sendfile:path:`, which the test casts before reading them.
  late state: sent :: Result
  late state: monitoredBefore :: List
  late state: monitoredAfter :: List

  /// Send the file and close the connection. Cast this with `!`.
  sendfile: sock :: Socket path: path :: String -> Result =>
    self.monitoredBefore := self monitoredBy
    self.sent := sock
      sendfile: path
      offset: 0
      length: 0
    self.monitoredAfter := self monitoredBy
    sock close

  /// The `sendfile:offset:length:` result.
  sent -> Result => self.sent

  /// This process's `monitored_by` list.
  monitoredBy -> List =>
    (Erlang erlang process_info: Erlang erlang self with: #monitored_by) at: 2

  /// Whether sending left no new monitor behind (the file was closed).
  closedFile -> Boolean => self.monitoredBefore =:= self.monitoredAfter
