/// `ReadOpt` from `server_test.exs`: logs the value of the socket option
/// named by the data it receives, then answers "ok".
RecordingHandler subclass: ReadOpt

  handleData: data :: Object socket: sock :: Socket state: st :: Object -> HandlerResult =>
    text :: String := data
    // A test fixture: the option names come from a fixed set in the tests.
    self note: {#opt, sock getopts: (#() add: text asAtom)}
    sock send: "ok"
    HandlerResult continue: st
