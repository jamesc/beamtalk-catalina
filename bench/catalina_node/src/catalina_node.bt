/// CatalinaNode — what the Erlang bench and stress harness
/// (`bench/harness/bench_node.erl`) calls in a Catalina peer node. Sealed
/// class methods compile to plain exported functions, so the harness calls
/// them directly (`'bt@catalina_node@catalina_node':'class_start:'/2`).
sealed typed Object subclass: CatalinaNode

  /// Start a server. `options` are `Catalina start:` options plus two of the
  /// harness's own: `#handler` is `#echo` or `#slowEcho` (a Symbol, not a
  /// class) and `#tls` is a Boolean selecting `SSLTransport`. Raises if the
  /// server cannot start.
  class sealed start: options :: Dictionary -> ServerSupervisor =>
    kind := options at: #handler ifAbsent: [#echo]
    handler := kind =:= #slowEcho ifTrue: [SlowEcho] ifFalse: [BenchEcho]
    tls := (options at: #tls ifAbsent: [false]) =:= true
    opts := (options removeKey: #tls) at: #handler put: handler
    tls ifTrue: [opts := opts at: #transport put: SSLTransport]
    (Catalina start: opts) unwrap
