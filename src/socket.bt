/// Socket — a client connection as a handler sees it: the raw socket, the
/// `Transport` class that drives it, and the connection's settings, as
/// Thousand Island's `ThousandIsland.Socket`.
///
/// A Socket is an immutable value. Calls that change the underlying socket
/// (`handshake`, `upgrade:options:`) answer a new Socket inside a `Result`.
///
/// Expected failures answer `Result error:`. An error from the transport's
/// Erlang call is an Exception, not the bare atom Elixir code sees: match
/// `e reason` (`#closed`, `#timeout`, `#econnreset`, ...), as in
/// `(sock recv: 0) ifError: [:e | e reason]`.
///
/// `peername` answers the address captured when the connection was
/// accepted, so it still works after the client has reset the connection.
///
/// Telemetry span events (`recv`, `send`, `sendfile`, their `_error`
/// forms and `socket_shutdown`) are added in Phase 5; until then `span` is
/// carried but not used.
///
/// ## Examples
/// ```beamtalk
/// config := HandlerConfig new
/// sock := Socket wrap: nil peername: {{127, 0, 0, 1}, 4000} handlerConfig: config span: nil
/// sock peername   // => Result ok: {{127, 0, 0, 1}, 4000}
/// sock isSecure   // => false
/// ```
sealed Value subclass: Socket
  field: socket = nil
  field: transport = TCPTransport
  field: readTimeout = 60000
  field: handshakeTimeout = 5000
  field: peername = nil
  field: silentTerminateOnError = false
  field: span = nil
  field: readTimer = nil
  field: readDeadline = nil
  field: timerDeadline = nil

  /// A Socket over an accepted raw socket, with the handler settings from
  /// `handlerConfig` and the connection's telemetry `span`.
  class sealed wrap: rawSocket :: Object peername: peer :: Object handlerConfig: handlerConfig :: HandlerConfig span: span :: Object -> Socket =>
    // The keyword constructor, not `new:`, which raises in a direct-called
    // class method (BT-4029).
    Socket
      socket: rawSocket
      transport: handlerConfig transport
      readTimeout: handlerConfig readTimeout
      handshakeTimeout: handlerConfig handshakeTimeout
      peername: peer
      silentTerminateOnError: handlerConfig silentTerminateOnError
      span: span
      readTimer: nil
      readDeadline: nil
      timerDeadline: nil

  /// Run the transport's handshake, bounded by `handshakeTimeout` when the
  /// transport answers `handshake:timeout:`, and answer the Socket over the
  /// handshaken socket. On failure the span is left to the handler, which
  /// stops it once when it closes the connection.
  handshake -> Result =>
    result := (self.transport respondsTo: #handshake:timeout:) ifTrue: [
      self.transport handshake: self.socket timeout: self.handshakeTimeout
    ] ifFalse: [self.transport handshake: self.socket]
    result map: [:inner | self withSocket: inner]

  /// Upgrade the connection to `newTransport` (for example to TLS) and
  /// answer the Socket over the upgraded socket. `options` go to the new
  /// transport unchanged.
  upgrade: newTransport options: options :: Object -> Result =>
    (newTransport upgrade: self.socket options: options) map: [:inner |
      (self withSocket: inner) withTransport: newTransport
    ]

  /// The next available bytes, waiting at most `readTimeout`.
  recv -> Result => self recv: 0

  /// Up to `length` bytes (0: the next available), waiting at most `readTimeout`.
  recv: length :: Integer -> Result => self recv: length timeout: nil

  /// Up to `length` bytes, waiting at most `timeout` ms (`nil`: `readTimeout`).
  recv: length :: Integer timeout: timeout :: Object -> Result =>
    self.transport
      recv: self.socket
      length: length
      timeout: (timeout ifNil: [self.readTimeout])

  /// Send a String or iodata.
  send: data :: Object -> Result => self.transport send: self.socket data: data

  /// Send `length` bytes of the file at `filename` from `offset` (0: to the end).
  sendfile: filename :: String offset: offset :: Integer length: length :: Integer -> Result =>
    self.transport
      sendfile: self.socket
      filename: filename
      offset: offset
      length: length

  /// Shut the connection down in one direction: `#read`, `#write` or `#read_write`.
  shutdown: way :: Symbol -> Result =>
    self.transport shutdown: self.socket how: way

  /// Close the connection. The handler that owns it also closes it when it exits.
  close -> Result => self.transport close: self.socket

  /// Read socket options.
  getopts: options :: List -> Result =>
    self.transport getopts: self.socket options: options

  /// Set socket options.
  setopts: options :: List -> Result =>
    self.transport setopts: self.socket options: options

  /// The local `{ip, port}`.
  sockname -> Result => self.transport sockname: self.socket

  /// The remote `{ip, port}` captured at accept time. Always `Result ok:`.
  peername -> Result => Result ok: self.peername

  /// The peer's DER certificate, or `Result error: #not_secure`.
  peercert -> Result => self.transport peercert: self.socket

  /// Whether the transport is encrypted.
  isSecure -> Boolean => self.transport isSecure

  /// The socket's `inet:getstat/1` counters.
  getstat -> Result => self.transport getstat: self.socket

  /// The protocol negotiated in the handshake (ALPN), if any.
  negotiatedProtocol -> Result => self.transport negotiatedProtocol: self.socket

  /// The TLS connection information, or `Result error: #not_secure`.
  connectionInformation -> Result =>
    self.transport connectionInformation: self.socket

  /// The telemetry span covering this connection.
  telemetrySpan -> Object => self.span
