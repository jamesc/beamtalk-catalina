/// Socket — a client connection as a handler sees it: the raw socket, the
/// `Transport` class that drives it, and the connection's settings, as
/// Thousand Island's `ThousandIsland.Socket`.
///
/// A Socket is an immutable value. Calls that change the underlying socket
/// (`handshake`, `upgrade:options:`) answer a new Socket inside a `Result`.
///
/// Expected failures answer `Result error:` with the transport's bare
/// Erlang reason (`#closed`, `#timeout`, `#econnreset`, ...; see
/// `Transport`), as in `(sock recv: 0) error =:= #closed`.
///
/// `peername` answers the address captured when the connection was
/// accepted, so it still works after the client has reset the connection.
///
/// `recv:...`, `send:`, `sendfile:...` and `shutdown:` emit their
/// telemetry events on the connection span (see `CatalinaTelemetry`).
///
/// ## Examples
/// ```beamtalk
/// config := HandlerConfig new
/// sock := Socket wrap: nil peername: {{127, 0, 0, 1}, 4000} handlerConfig: config span: nil
/// sock peername   // => Result ok: {{127, 0, 0, 1}, 4000}
/// sock isSecure   // => false
/// ```
sealed typed Value subclass: Socket
  // The raw socket: a gen_tcp port, or an ssl socket record (Phase 4).
  field: socket :: Port | Tuple
  // A class conforming to `Transport` (see `ServerConfig`).
  field: transport :: Dynamic = TCPTransport
  field: readTimeout :: Integer | #infinity = 60000
  field: handshakeTimeout :: Integer | #infinity = 5000
  field: peername :: Tuple | Nil = nil
  field: silentTerminateOnError :: Boolean = false
  // The connection telemetry span; nil for a Socket made outside a server.
  field: span :: CatalinaTelemetry | Nil = nil

  /// A Socket over an accepted raw socket, with the handler settings from
  /// `handlerConfig` and the connection's telemetry `span`.
  class sealed wrap: rawSocket :: Port | Tuple peername: peer :: Tuple | Nil handlerConfig: handlerConfig :: HandlerConfig span: span :: CatalinaTelemetry | Nil -> Socket =>
    Socket
      socket: rawSocket
      transport: handlerConfig transport
      readTimeout: handlerConfig readTimeout
      handshakeTimeout: handlerConfig handshakeTimeout
      peername: peer
      silentTerminateOnError: handlerConfig silentTerminateOnError
      span: span

  /// Run the transport's handshake, bounded by `handshakeTimeout` when the
  /// transport answers `handshake:timeout:`, and answer the Socket over the
  /// handshaken socket. On failure the span is left to the handler, which
  /// stops it once when it closes the connection.
  handshake -> Result(Socket, Object) =>
    result := (self.transport respondsTo: #handshake:timeout:) ifTrue: [
      self.transport handshake: self.socket timeout: self.handshakeTimeout
    ] ifFalse: [self.transport handshake: self.socket]
    result map: [:inner | self withSocket: inner]

  /// Upgrade the connection to `newTransport` (for example to TLS) and
  /// answer the Socket over the upgraded socket. `options` go to the new
  /// transport unchanged.
  upgrade: newTransport :: Dynamic options: options :: Object -> Result(Socket, Object) =>
    (newTransport upgrade: self.socket options: options) map: [:inner |
      (self withSocket: inner) withTransport: newTransport
    ]

  /// The next available bytes, waiting at most `readTimeout`.
  recv -> Result(Binary, Object) => self recv: 0

  /// Up to `length` bytes (0: the next available), waiting at most `readTimeout`.
  recv: length :: Integer -> Result(Binary, Object) =>
    self recv: length timeout: nil

  /// Up to `length` bytes, waiting at most `timeout` ms (`nil`: `readTimeout`).
  /// Emits `recv` (`#data`) or `recv_error` (`#error`).
  recv: length :: Integer timeout: timeout :: Object -> Result(Binary, Object) =>
    result := self.transport
      recv: self.socket
      length: length
      timeout: (timeout ifNil: [self.readTimeout])
    result isOk ifTrue: [
      self untimed: #recv measurements: #{#data => result value}
    ] ifFalse: [self event: #recv_error measurements: #{#error => result error}]
    result

  /// Send a String or iodata. Emits `send` (`#data`) or `send_error`
  /// (`#data`, `#error`).
  send: data :: Object -> Result(Nil, Object) =>
    result := self.transport send: self.socket data: data
    result isOk ifTrue: [
      self untimed: #send measurements: #{#data => data}
    ] ifFalse: [
      self event: #send_error measurements: #{
        #data => data,
        #error => result error
      }
    ]
    result

  /// Send `length` bytes of the file at `filename` from `offset` (0: to the
  /// end). Emits `sendfile` (`#filename`, `#offset`, `#bytes_written`) or
  /// `sendfile_error` (`#filename`, `#offset`, `#length`, `#error`).
  sendfile: filename :: String offset: offset :: Integer length: length :: Integer -> Result(Integer, Object) =>
    result := self.transport
      sendfile: self.socket
      filename: filename
      offset: offset
      length: length
    result isOk
      ifTrue: [
        self untimed: #sendfile measurements: #{
          #filename => filename,
          #offset => offset,
          #bytes_written => result value
        }
      ]
      ifFalse: [
        self
          event: #sendfile_error
          measurements: #{
            #filename => filename,
            #offset => offset,
            #length => length,
            #error => result error
          }
      ]
    result

  /// Shut the connection down in one direction: `#read`, `#write` or
  /// `#read_write`. Emits `socket_shutdown` (`#way`).
  shutdown: way :: Symbol -> Result(Nil, Object) =>
    self event: #socket_shutdown measurements: #{#way => way}
    self.transport shutdown: self.socket how: way

  /// Close the connection. The handler that owns it also closes it when it exits.
  close -> Result(Nil, Object) => self.transport close: self.socket

  /// Read socket options.
  getopts: options :: List(Symbol | Tuple) -> Result(List, Object) =>
    self.transport getopts: self.socket options: options

  /// Set socket options.
  setopts: options :: List(Symbol | Tuple) -> Result(Nil, Object) =>
    self.transport setopts: self.socket options: options

  /// The local `{ip, port}`.
  sockname -> Result(Tuple, Object) => self.transport sockname: self.socket

  /// The remote `{ip, port}` captured at accept time. Always `Result ok:`.
  peername -> Result(Tuple | Nil, Object) => Result ok: self.peername

  /// The peer's DER certificate, or `Result error: #not_secure`.
  peercert -> Result(Binary, Object) => self.transport peercert: self.socket

  /// Whether the transport is encrypted.
  isSecure -> Boolean => self.transport isSecure

  /// The socket's `inet:getstat/1` counters.
  getstat -> Result(List(Tuple), Object) => self.transport getstat: self.socket

  /// The protocol negotiated in the handshake (ALPN), if any.
  negotiatedProtocol -> Result(Binary, Object) =>
    self.transport negotiatedProtocol: self.socket

  /// The TLS connection information, or `Result error: #not_secure`.
  connectionInformation -> Result(List, Object) =>
    self.transport connectionInformation: self.socket

  /// The telemetry span covering this connection (nil outside a server).
  telemetrySpan -> CatalinaTelemetry | Nil => self.span

  /// An event on the connection span, with the time (`span_event/4`).
  event: name :: Symbol measurements: measurements :: Dictionary(Symbol, Object) -> Socket =>
    span := self.span
    span isNil
      ifFalse: [
        span
          event: name
          measurements: measurements
          metadata: #{}
      ]
    self

  /// An event on the connection span, without the time
  /// (`untimed_span_event/4`).
  untimed: name :: Symbol measurements: measurements :: Dictionary(Symbol, Object) -> Socket =>
    span := self.span
    span isNil
      ifFalse: [
        span
          untimedEvent: name
          measurements: measurements
          metadata: #{}
      ]
    self
