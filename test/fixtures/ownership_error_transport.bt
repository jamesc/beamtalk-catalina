/// `OwnershipErrorTransport` from `connection_test.exs`. Its "socket" is a
/// `{tableName, reason}` tuple; `controllingProcess:pid:` records the pid
/// and fails with `reason`, and `close:` records the close, both in that Ets
/// table. Everything else is unsupported.
sealed typed Object subclass: OwnershipErrorTransport

  class table: socket :: Tuple -> Ets => Ets named: (socket at: 1)

  class controllingProcess: socket :: Tuple pid: pid :: Pid -> Result =>
    (self table: socket) at: #controllingProcess put: pid
    Result error: (socket at: 2)

  class close: socket :: Tuple -> Result =>
    (self table: socket) at: #closed put: true
    Result ok: nil

  class listen: _port :: Integer options: _options :: List -> Result =>
    Result error: #enotsup

  class accept: _listenSocket :: Object -> Result => Result error: #enotsup

  class handshake: socket :: Object -> Result => Result ok: socket

  class upgrade: _socket :: Object options: _options :: Object -> Result =>
    Result error: #unsupported_upgrade

  class recv: _socket :: Object length: _length :: Integer timeout: _timeout :: Object -> Result =>
    Result error: #enotsup

  class send: _socket :: Object data: _data :: Object -> Result =>
    Result error: #enotsup

  class sendfile: _socket :: Object filename: _filename :: String offset: _offset :: Integer length: _length :: Integer -> Result =>
    Result error: #enotsup

  class getopts: _socket :: Object options: _options :: List -> Result =>
    Result error: #enotsup

  class setopts: _socket :: Object options: _options :: List -> Result =>
    Result error: #enotsup

  class shutdown: _socket :: Object how: _way :: Symbol -> Result =>
    Result error: #enotsup

  class sockname: _socket :: Object -> Result => Result error: #enotsup

  class peername: _socket :: Object -> Result => Result error: #enotsup

  class peercert: _socket :: Object -> Result => Result error: #not_secure

  class isSecure -> Boolean => false

  class getstat: _socket :: Object -> Result => Result error: #enotsup

  class negotiatedProtocol: _socket :: Object -> Result =>
    Result error: #protocol_not_negotiated

  class connectionInformation: _socket :: Object -> Result =>
    Result error: #not_secure
