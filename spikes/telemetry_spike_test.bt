/// Spike 5 (PLAN.md Phase 0): `(Erlang telemetry) execute:with:with:` works
/// with the hex dependency declared in `[native.dependencies]`, and a
/// Beamtalk block can be the attached handler function.
TestCase subclass: TelemetrySpikeTest

  testExecuteReachesABlockHandler =>
    table := Ets new: #telemetrySpike type: #set
    handler := [:event :measurements :metadata :config |
      (Ets named: #telemetrySpike) at: #seen put: {event, measurements, metadata, config}
    ]
    attached := (Erlang telemetry)
      attach: "catalina-spike"
      with: #(#catalina, #spike, #ping)
      with: handler
      with: #cfg
    self assert: attached isOk
    (Erlang telemetry)
      execute: #(#catalina, #spike, #ping)
      with: #{#count => 1}
      with: #{#who => #spike}
    {event, measurements, metadata, config} := table at: #seen
    self assert: event equals: #(#catalina, #spike, #ping)
    self assert: (measurements at: #count) equals: 1
    self assert: (metadata at: #who) equals: #spike
    self assert: config equals: #cfg
    (Erlang telemetry) detach: "catalina-spike"
    table delete

  testExecuteWithNoHandlerIsANoOp =>
    self
      assert: ((Erlang telemetry)
        execute: #(#catalina, #spike, #unheard)
        with: #{}
        with: #{}) isOk

  testDuplicateAttachIsAnError =>
    handler := [:e :m :md :c | nil]
    (Erlang telemetry)
      attach: "catalina-spike-dup"
      with: #(#catalina, #dup)
      with: handler
      with: nil
    second := (Erlang telemetry)
      attach: "catalina-spike-dup"
      with: #(#catalina, #dup)
      with: handler
      with: nil
    self assert: second isError
    self assert: second error reason equals: #already_exists
    (Erlang telemetry) detach: "catalina-spike-dup"
