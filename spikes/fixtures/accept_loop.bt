/// Spike 3: an acceptor that blocks in `gen_tcp:accept/1` inside
/// `handleInfo: #accept` and re-sends `#accept` to itself after each
/// connection. `{error, closed}` ends it normally, as Thousand Island's
/// acceptor task does. It does not override `terminate:`, so it does not trap
/// exits and a supervisor's `shutdown` exit kills it even while it is blocked.
///
/// As PLAN.md's `Acceptor`, it starts from a `continueWith:` step (where the
/// real one makes its parent lookups) that sends the first `#accept`.
///
/// While blocked in accept it cannot answer calls, so it reports into the
/// shared Ets table named by `tableName` instead.
Server subclass: AcceptLoop
  state: listenSocket = nil
  state: tableName = nil
  state: accepted = 0

  initialize => self continueWith: #attach

  attach =>
    self record: #pid value: self pid
    Erlang erlang send: self pid msg: #accept

  handleInfo: msg =>
    msg match: [
      #accept -> self acceptOnce;
      _ -> nil
    ]

  acceptOnce =>
    result := (Erlang gen_tcp) accept: self.listenSocket
    result isOk ifTrue: [
      self onAccepted: result value
    ] ifFalse: [self onAcceptError: result error]

  onAccepted: sock =>
    self.accepted := self.accepted + 1
    self record: #accepted value: self.accepted
    (Erlang gen_tcp) close: sock
    Erlang erlang send: self pid msg: #accept

  onAcceptError: error =>
    self record: #acceptError value: error reason
    error reason =:= #closed ifTrue: [self stop] ifFalse: [error signal]

  record: key value: value =>
    self.tableName isNil ifFalse: [
      (Ets named: self.tableName) at: key put: value
    ]
