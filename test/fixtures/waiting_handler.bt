/// `WaitingHandler` from `connection_test.exs`: it records its start, the
/// ready message and its exit reason in the Ets table named by
/// `handlerOptions`. It overrides `terminate:`, so it traps exits.
typed Server subclass: WaitingHandler
  // The name of the Ets table to record in (the start args).
  state: handlerOptions :: Symbol

  initialize -> Nil => self record: #started value: self pid

  handleInfo: msg :: Object -> Object =>
    msg match: [
      {#catalina_ready, _raw, _config, _span, _start} -> self record: #ready value: self pid;
      _ -> nil
    ]

  terminate: reason :: Object -> Nil => self record: #terminated value: reason

  record: key :: Symbol value: value :: Object -> Nil =>
    (Ets named: self.handlerOptions) at: key put: value
