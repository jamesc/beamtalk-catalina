/// A transport with only the original `handshake:`, as a third-party
/// transport written before `handshake:timeout:` existed would be. The
/// handshake tags the socket so a test can see which one ran; everything
/// else delegates to `TCPTransport`. From `socket_test.exs`.
sealed typed Object subclass: LegacyTransport

  class listen: port :: Integer options: options :: List -> Result =>
    TCPTransport listen: port options: options

  class accept: listenSocket :: Object -> Result =>
    TCPTransport accept: listenSocket

  class handshake: socket :: Object -> Result => Result ok: {#legacy, socket}

  class upgrade: socket :: Object options: options :: Object -> Result =>
    TCPTransport upgrade: socket options: options

  class controllingProcess: socket :: Object pid: pid :: Pid -> Result =>
    TCPTransport controllingProcess: socket pid: pid

  class recv: socket :: Object length: length :: Integer timeout: timeout :: Object -> Result =>
    TCPTransport
      recv: socket
      length: length
      timeout: timeout

  class send: socket :: Object data: data :: Object -> Result =>
    TCPTransport send: socket data: data

  class sendfile: socket :: Object filename: filename :: String offset: offset :: Integer length: length :: Integer -> Result =>
    TCPTransport
      sendfile: socket
      filename: filename
      offset: offset
      length: length

  class getopts: socket :: Object options: options :: List -> Result =>
    TCPTransport getopts: socket options: options

  class setopts: socket :: Object options: options :: List -> Result =>
    TCPTransport setopts: socket options: options

  class shutdown: socket :: Object how: way :: Symbol -> Result =>
    TCPTransport shutdown: socket how: way

  class close: socket :: Object -> Result => TCPTransport close: socket

  class sockname: socket :: Object -> Result => TCPTransport sockname: socket

  class peername: socket :: Object -> Result => TCPTransport peername: socket

  class peercert: socket :: Object -> Result => TCPTransport peercert: socket

  class isSecure -> Boolean => TCPTransport isSecure

  class getstat: socket :: Object -> Result => TCPTransport getstat: socket

  class negotiatedProtocol: socket :: Object -> Result =>
    TCPTransport negotiatedProtocol: socket

  class connectionInformation: socket :: Object -> Result =>
    TCPTransport connectionInformation: socket
