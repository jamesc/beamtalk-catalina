/// `OneShotTimeoutWithLocalMessages`: "start" sets a 50 ms one-shot
/// timeout and starts a local message flood.
RecordingHandler subclass: OneShotWithLocal

  handleData: data :: Object socket: _sock :: Socket state: st :: Object -> HandlerResult =>
    text :: String := data
    (text startsWith: "start")
      ifTrue: [
        self scheduleLocal
        HandlerResult continue: st timeout: 50
      ]
      ifFalse: [HandlerResult continue: st]

  handleUserInfo: msg :: Object -> Object =>
    msg =:= #localMessage ifTrue: [self scheduleLocal]

  scheduleLocal -> Object =>
    Timer
      send: #localMessage
      to: self
      after: 10
