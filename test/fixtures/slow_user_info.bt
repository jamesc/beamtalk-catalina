/// `LongGenServerCallbacksDoAffectTimeout`: time in a slow non-Catalina
/// message does count against the read timeout.
RecordingHandler subclass: SlowUserInfo

  handleConnection: _sock :: Socket state: st :: Object -> HandlerResult =>
    Erlang erlang send: self pid msg: #sleepThenSend
    HandlerResult continue: st

  handleUserInfo: msg :: Object -> Object =>
    msg match: [
      #sleepThenSend -> self sleepThenSend;
      #sendBytes -> self socket send: "A";
      _ -> nil
    ]

  sleepThenSend -> Object =>
    Timer sleep: 75
    Erlang erlang
      send_after: 50
      dest: self pid
      msg: #sendBytes
