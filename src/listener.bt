/// Listener — owns a server's listen sockets, as Thousand Island's
/// `ThousandIsland.Listener`.
///
/// It opens `numListenSockets` sockets when it starts. Sockets after the
/// first bind to the port the first one actually got, so port 0 works with
/// several sockets (`reuseport`). If any socket fails to open, the ones
/// already open are closed and the start fails with the transport's error.
///
/// Acceptors ask for their socket with `acceptorInfo:`, round-robin over
/// the sockets. When the listener stops, its sockets close and every
/// acceptor's `accept` answers `closed`, which ends it normally: that is
/// how a server stops accepting while its connections drain.
///
/// Args: `#config`, the server's `ServerConfig`. Restart: `#transient`.
///
/// It owns the server's `#listener` telemetry span: started once the
/// sockets are open, stopped in `terminate:` (so the listener traps exits,
/// which is harmless: it never blocks).
///
/// ## Examples
/// ```beamtalk
/// listener := srv listener unwrap
/// listener listenerInfo    // => {{0, 0, 0, 0}, 4000}
/// listener acceptorInfo: 1 // => the listen socket acceptor 1 uses
/// ```
typed Actor subclass: Listener
  state: config :: ServerConfig
  // The listen sockets, opened once by `initialize` and open for the
  // listener's life (it is stopped, not emptied). A TCP listen socket is a
  // Port, a TLS one an `sslsocket` record (a Tuple).
  late state: sockets :: List(Port | Tuple)
  // The `#listener` span, started by `initialize` once the sockets are open.
  late state: span :: CatalinaTelemetry
  // The first socket's `{ip, port}` (or `{local, path}`), set by `initialize`.
  late state: localInfo :: SocketAddress

  class supervisionPolicy -> RestartStrategy => #transient

  /// Which listen socket (1-based) acceptor `id` uses: `(id - 1) rem n + 1`,
  /// as Ranch and Thousand Island distribute them.
  class sealed socketIndexFor: id :: Integer count: n :: Integer -> Integer =>
    (id - 1) % n + 1

  initialize -> Nil => self openSockets

  /// The local `{ip, port}` of the first listen socket.
  listenerInfo -> SocketAddress => self.localInfo

  /// The listen socket acceptor `id` accepts on.
  acceptorInfo: id :: Integer -> Port | Tuple =>
    self.sockets at: (Listener socketIndexFor: id count: self.sockets size)

  /// The listen sockets, in order.
  listenSockets -> List(Port | Tuple) => self.sockets

  /// The `#listener` span, parent of the acceptors' spans.
  listenerSpan -> CatalinaTelemetry => self.span

  terminate: _reason :: Object -> Nil =>
    (self hasField: #span) ifTrue: [self.span stop]
    nil

  /// Open the sockets, or close the ones already open and fail.
  openSockets -> Nil =>
    transport := self.config transport
    first := transport listen: self.config port options: self.config transportOptions
    first isError ifTrue: [^self failWith: first error]
    opened :: List(Port | Tuple) := #() add: first value
    info := transport sockname: first value
    info isError
      ifTrue: [
        // Sockets are closed here, not in a helper: a List of ports is bound
        // to this process and is not passed in a message, even to self.
        opened do: [:s | transport close: s]
        ^self failWith: info error
      ]
    local :: SocketAddress := info value
    port := self bindPort: local
    2
      to: self.config numListenSockets
      do: [:_i |
        next := transport listen: port options: self.config transportOptions
        next isError
          ifTrue: [
            opened do: [:s | transport close: s]
            ^self failWith: next error
          ]
        opened := opened add: next value
      ]
    self.sockets := opened
    self.localInfo := local
    self.span := CatalinaTelemetry
      startSpan: #listener
      measurements: #{}
      metadata: #{
        #handler => self.config handler,
        #local_address => (local at: 1),
        #local_port => (local at: 2),
        #transport_module => self.config transport,
        #transport_options => self.config transportOptions
      }
    nil

  /// The port further sockets bind to: the one the OS gave the first
  /// socket, or the configured one for a non-IP (Unix domain) socket.
  bindPort: info :: Tuple -> Integer =>
    (((info isKindOf: Tuple) and: [
      info size =:= 2
    ]) and: [
      (info at: 2) isKindOf: Integer
    ]) ifTrue: [info at: 2] ifFalse: [self.config port]

  /// Fail the start with the transport's reason.
  failWith: reason :: Object -> Nil =>
    Error signal: "Listener could not open its sockets: " ++ reason printString
