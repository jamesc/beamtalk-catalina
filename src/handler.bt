/// Handler — the per-connection process: subclass it and override the
/// callbacks you need, as with Thousand Island's `ThousandIsland.Handler`.
///
/// Lifecycle:
///
/// 1. The acceptor starts the handler and hands it the accepted socket with
///    a ready message. The handler wraps it in a `Socket`, runs the
///    transport's handshake and calls `handleConnection:state:`.
/// 2. Each callback answers a `HandlerResult`. `continue:` arms the socket
///    (`{active, once}`) and waits; data arrives in
///    `handleData:socket:state:`. `close:` and `error:state:` end the
///    connection.
/// 3. Between callbacks the handler is an ordinary `Server`: other
///    processes may call its methods, and messages that are not Catalina's
///    go to `handleUserInfo:`.
///
/// State is the socket plus the user state, as Thousand Island's
/// `{socket, state}`: the first user state is the server's `handlerOptions`,
/// each callback gets it as `state:` and answers the next one inside its
/// `HandlerResult`. Methods of a subclass may read `self socket` and
/// `self userState`, and `handleUserInfo:` may set `self.userState`.
///
/// Callbacks (all optional):
///
/// | Thousand Island | Catalina | Default |
/// |---|---|---|
/// | `handle_connection(socket, state)` | `handleConnection: sock state: st` | `HandlerResult continue: st` |
/// | `handle_data(data, socket, state)` | `handleData: data socket: sock state: st` | `HandlerResult continue: st` |
/// | `handle_close(socket, state)` | `handleClose: sock state: st` | nothing |
/// | `handle_error(reason, socket, state)` | `handleError: reason socket: sock state: st` | nothing |
/// | `handle_shutdown(socket, state)` | `handleShutdown: sock state: st` | nothing |
/// | `handle_timeout(socket, state)` | `handleTimeout: sock state: st` | nothing |
/// | `handle_info(msg, {socket, state})` | `handleUserInfo: msg` | ignore |
///
/// How the connection ends decides which of the last four runs, from the
/// exit reason, exactly as `handler.ex`'s `terminate/2`: a read timeout →
/// `handleTimeout:`; the server shutting down → `handleShutdown:`; a peer
/// close or `close:` → `handleClose:`; a handshake or upgrade failure,
/// `error:state:`, a socket error or a raised error → `handleError:`. Then
/// the socket is closed.
///
/// A callback that raises crashes the handler (ADR 0134), as in Elixir:
/// `handleError:` runs with the error as the reason and the supervisor sees
/// a crash. `error:state:` stops with the reason itself, also logged as a
/// crash, unless the server's `silentTerminateOnError` is set.
///
/// The read timeout is lazy, as Thousand Island 1.6's: data only moves the
/// deadline, and a single timer re-arms itself for the remainder when it
/// fires early. Its messages carry a fresh ref, so a cancelled timer's late
/// message is ignored without a mailbox flush. Time spent in a callback
/// does not count against it (the deadline is set when the callback
/// returns), but time in other messages does; `handleContinuation:` is the
/// escape hatch for those.
///
/// `Handler` is `typed`, and so is every subclass: annotate the callbacks
/// you override with the signatures below (a narrower parameter type than
/// the inherited one is rejected, so narrow inside the method instead).
///
/// ## Examples
/// ```beamtalk
/// Handler subclass: EchoHandler
///   handleData: data :: Object socket: sock :: Socket state: st :: Object -> HandlerResult =>
///     sock send: data
///     HandlerResult continue: st
/// ```
typed Server subclass: Handler
  // The server's `handlerOptions`, from the start args. Any term is a
  // valid option value, nil included, so it is not `late` (a `late` slot's
  // type must not admit nil; BT-4061).
  state: handlerOptions :: Object = nil
  // Set by the ready message. Reads reachable from `handleInfo:` and
  // `terminate:` are guarded with `hasField:`.
  late state: socket :: Socket
  // The callbacks' state: user data, where nil is a legitimate value.
  state: userState :: Object = nil
  // The timer slots stay nilable: a timer is cancelled and re-armed, so a
  // stale value would be wrong.
  state: readTimer :: Timer | Nil = nil
  // The ref the running timer's message carries; a message with any other
  // ref is stale.
  state: timerTag :: Reference | Nil = nil
  // Monotonic milliseconds.
  state: readDeadline :: Integer | Nil = nil
  state: timerDeadline :: Integer | Nil = nil
  // The acceptor that started this handler (`#acceptor` in the start args;
  // nil when started some other way), monitored until the ready message
  // arrives. If it dies first, the ready message never comes, and without
  // the monitor this handler would wait for it forever.
  state: acceptor :: Pid | Nil = nil
  state: acceptorMonitor :: Reference | Nil = nil

  /// Handlers are never restarted: a connection that ends is gone.
  class supervisionPolicy -> RestartStrategy => #temporary

  initialize -> Nil =>
    self.userState := self.handlerOptions
    starter := self.acceptor
    starter isNil ifFalse: [
      self.acceptorMonitor := Erlang erlang monitor: #process with: starter
    ]
    nil

  // === Callbacks ===

  /// The connection is ready (after the handshake).
  handleConnection: _sock :: Socket state: st :: Object -> HandlerResult =>
    HandlerResult continue: st

  /// Data arrived on the socket.
  handleData: _data :: Object socket: _sock :: Socket state: st :: Object -> HandlerResult =>
    HandlerResult continue: st

  /// The peer closed the connection, or a callback answered `close:`.
  handleClose: _sock :: Socket state: _st :: Object -> Object => nil

  /// The connection failed: `reason` is the transport's bare reason, the
  /// `error:state:` reason, or `{exception, stacktrace}` for an error a
  /// callback raised (Elixir's `{error, stacktrace}`).
  handleError: _reason :: Object socket: _sock :: Socket state: _st :: Object -> Object =>
    nil

  /// The server is shutting down. The socket is still open.
  handleShutdown: _sock :: Socket state: _st :: Object -> Object => nil

  /// The read timeout expired. The socket is still open.
  handleTimeout: _sock :: Socket state: _st :: Object -> Object => nil

  /// A message that is not Catalina's. Ignored unless overridden.
  handleUserInfo: _msg :: Object -> Object => nil

  // === Accessors ===

  /// The connection's `Socket` (nil until the ready message arrives).
  socket -> Socket => self.socket

  /// The current user state.
  userState -> Object => self.userState

  /// The server's `handlerOptions`, the first user state.
  handlerOptions -> Object => self.handlerOptions

  // === Messages ===
  sealed handleInfo: msg :: Object -> Object =>
    msg match: [
      {#catalina_ready, raw, config, span, start} -> self
        onReady: raw
        config: config
        span: span
        start: start;
      {#tcp, raw, data} -> self
        onData: data
        from: raw
        message: msg;
      {#ssl, raw, data} -> self
        onData: data
        from: raw
        message: msg;
      {#tcp_closed, raw} -> self onClosed: raw message: msg;
      {#ssl_closed, raw} -> self onClosed: raw message: msg;
      {#tcp_error, raw, reason} -> self
        onSocketError: reason
        from: raw
        message: msg;
      {#ssl_error, raw, reason} -> self
        onSocketError: reason
        from: raw
        message: msg;
      {#catalina_read_timeout, tag} -> self onReadTimeout: tag;
      {#DOWN, ref, #process, _pid, _reason} -> self onDown: ref message: msg;
      _ -> self handleUserInfo: msg
    ]

  onReady: raw :: Object config: config :: HandlerConfig span: acceptorSpan :: CatalinaTelemetry | Nil start: start :: Integer -> Nil =>
    self stopWatchingAcceptor
    transport := config transport
    peer := transport peername: raw
    peer isError
      ifTrue: [
        // The client closed before we got here: nothing to do but close.
        transport close: raw
        self stopWith: {#shutdown, {#premature_conn_closing, peer error}}
        ^nil
      ]
    remote :: Tuple := peer value
    self processLabel: {#catalina_connection, remote}
    span := acceptorSpan isNil
      ifTrue: [nil]
      ifFalse: [
        acceptorSpan
          startChild: #connection
          measurements: #{#monotonic_time => start}
          metadata: #{
            #remote_address => (remote at: 1),
            #remote_port => (remote at: 2)
          }
      ]
    sock := Socket
      wrap: raw
      peername: remote
      handlerConfig: config
      span: span
    shaken := sock handshake
    shaken isError
      ifTrue: [
        // Kept, so `terminate:` closes it and reports the handshake error.
        self.socket := sock
        self stopWith: {#shutdown, {#handshake, shaken error}}
        ^nil
      ]
    self.socket := shaken value
    span isNil
      ifFalse: [
        span
          event: #ready
          measurements: #{}
          metadata: #{}
      ]
    // A continuation, so the socket is in state before the callback runs
    // and a raise in it still closes the socket in `terminate:`.
    self continueWith: #runHandleConnection
    nil

  // The two callback calls below are wrapped in an inline `on:do:` that
  // emits the span's `exception` event and re-raises (Thousand Island's
  // `invoke_callback/2`). A block handed to a helper method could not keep
  // the callback's field writes (ADR 0133), so each one is inline.
  runHandleConnection -> Nil =>
    sock := self.socket
    result := [
      self handleConnection: sock state: self.userState
    ] on: Exception do: [:e | self raised: e on: sock]
    self handleContinuation: result

  /// The acceptor died between starting this handler and handing it the
  /// socket (killed, say): the ready message will never come, so stop. The
  /// socket, if it was already handed over, closes with this process. Any
  /// other `DOWN` is the subclass's own monitor.
  onDown: ref :: Reference message: msg :: Object -> Object =>
    ref =:= self.acceptorMonitor ifFalse: [^self handleUserInfo: msg]
    self.acceptorMonitor := nil
    self stopWith: {#shutdown, #acceptor_down}
    nil

  stopWatchingAcceptor -> Nil =>
    ref := self.acceptorMonitor
    ref isNil ifFalse: [Erlang erlang demonitor: ref with: #(#flush)]
    self.acceptorMonitor := nil
    nil

  // A socket message for another socket, or one before the ready message,
  // goes to `handleUserInfo:`.
  onData: data :: Object from: raw :: Object message: msg :: Object -> Object =>
    (self hasField: #socket)
      ifTrue: [
        sock := self.socket
        raw =:= sock socket
          ifTrue: [
            sock untimed: #async_recv measurements: #{#data => data}
            result := [
              self
                handleData: data
                socket: sock
                state: self.userState
            ] on: Exception do: [:e | self raised: e on: sock]
            ^self handleContinuation: result
          ]
      ]
    self handleUserInfo: msg

  onClosed: raw :: Object message: msg :: Object -> Object =>
    (self hasField: #socket) ifTrue: [
      raw =:= self.socket socket ifTrue: [
        ^self stopWith: {#shutdown, #peer_closed}
      ]
    ]
    self handleUserInfo: msg

  onSocketError: reason :: Object from: raw :: Object message: msg :: Object -> Object =>
    (self hasField: #socket) ifTrue: [
      raw =:= self.socket socket ifTrue: [^self stopWith: reason]
    ]
    self handleUserInfo: msg

  /// A callback raised: emit `exception` on the connection span (which
  /// ends it), then re-raise, so the handler crashes as in Elixir.
  raised: error :: Exception on: sock :: Socket -> Never =>
    span := sock telemetrySpan
    span isNil
      ifFalse: [
        kind := (error isKindOf: ExitError) ifTrue: [
          #exit
        ] ifFalse: [
          (error isKindOf: ThrowError) ifTrue: [#throw] ifFalse: [#error]
        ]
        reason := kind =:= #error ifTrue: [error] ifFalse: [error reason]
        span
          exceptionKind: kind
          reason: reason
          stacktrace: error stackTrace
      ]
    error signal

  // === Continuations ===

  /// Act on a callback's `HandlerResult`, as `handle_continuation/2`. A
  /// subclass may call it from `handleUserInfo:` to re-arm the socket and
  /// reset the read timeout, as Thousand Island's escape hatch.
  handleContinuation: result :: HandlerResult -> Nil =>
    self.userState := result state
    result kind match: [
      #continue -> self continueReading: result;
      #switchTransport -> self switchTransportWith: result;
      #close -> self closeLocally;
      _ -> self failWith: result reason
    ]
    nil

  continueReading: result :: HandlerResult -> Nil =>
    timeout := result timeout
    (result persistent and: [
      timeout notNil
    ]) ifTrue: [self.socket := self.socket withReadTimeout: timeout]
    self.socket setopts: #({#active, #once})
    self armReadTimer: (timeout ifNil: [self.socket readTimeout])
    next := result then
    next isNil ifFalse: [self continueWith: next]
    nil

  switchTransportWith: result :: HandlerResult -> Nil =>
    upgraded := self.socket upgrade: result transport options: result options
    upgraded isError
      ifTrue: [
        self stopWith: {#shutdown, {#upgrade, upgraded error}}
        ^nil
      ]
    self.socket := upgraded value
    // Thousand Island passes an integer here on as a GenServer timeout;
    // Catalina uses it as the read timeout, as `continue:timeout:` does.
    self continueReading: result

  closeLocally -> Nil =>
    self cancelReadTimer
    self stopWith: {#shutdown, #local_closed}
    nil

  failWith: reason :: Object -> Nil =>
    self cancelReadTimer
    reason =:= #timeout
      ifTrue: [self stopWith: {#shutdown, #read_timeout}]
      ifFalse: [
        self.socket silentTerminateOnError ifTrue: [
          self stopWith: {#shutdown, {#silent_termination, reason}}
        ] ifFalse: [self stopWith: reason]
      ]
    nil

  // === Read timeout ===
  armReadTimer: timeout :: Integer | #infinity -> Nil =>
    timeout =:= #infinity ifTrue: [^self cancelReadTimer]
    ms := timeout
    deadline := self now + ms
    running := self.timerDeadline
    running isNil ifTrue: [^self startTimer: ms deadline: deadline]
    running <= deadline
      ifTrue: [
        // The running timer fires first and re-arms for what is left.
        self.readDeadline := deadline
      ]
      ifFalse: [
        self cancelReadTimer
        self startTimer: ms deadline: deadline
      ]
    nil

  startTimer: ms :: Integer deadline: deadline :: Integer -> Nil =>
    tag := Reference new
    self.timerTag := tag
    self.readTimer := Timer
      send: {#catalina_read_timeout, tag}
      to: self
      after: ms
    self.readDeadline := deadline
    self.timerDeadline := deadline
    nil

  cancelReadTimer -> Nil =>
    timer := self.readTimer
    timer isNil ifFalse: [timer cancel]
    self.readTimer := nil
    self.timerTag := nil
    self.readDeadline := nil
    self.timerDeadline := nil
    nil

  /// A timer fired. A stale one (cancelled, or replaced) is ignored; an
  /// early one re-arms for the rest of the deadline.
  onReadTimeout: tag :: Reference -> Nil =>
    tag =:= self.timerTag ifFalse: [^nil]
    deadline := self.readDeadline
    self.readTimer := nil
    self.timerTag := nil
    deadline isNil ifTrue: [^nil]
    now := self now
    now >= deadline
      ifTrue: [
        self stopWith: {#shutdown, #read_timeout}
        ^nil
      ]
    self startTimer: deadline - now deadline: deadline

  now -> Integer => Erlang erlang monotonic_time: #millisecond

  // === Termination ===
  terminate: reason :: Object -> Nil =>
    // No socket if the client closed before the ready message was handled:
    // nothing to close then.
    (self hasField: #socket) ifTrue: [self end: self.socket for: reason]
    nil

  /// Route the exit reason to its callback, as `handler.ex`'s `terminate/2`.
  end: sock :: Socket for: reason :: Object -> Nil =>
    reason match: [
      {#shutdown, #read_timeout} -> self
        end: sock
        with: #timeout
        callback: #timeout
        reason: nil;
      #shutdown -> self
        end: sock
        with: #shutdown
        callback: #shutdown
        reason: nil;
      {#shutdown, {#handshake, r}} -> self
        end: sock
        with: r
        callback: #error
        reason: r;
      {#shutdown, {#silent_termination, r}} -> self
        end: sock
        with: r
        callback: #error
        reason: r;
      {#shutdown, {#upgrade, r}} -> self
        end: sock
        with: r
        callback: #error
        reason: r;
      {#shutdown, r} -> self
        end: sock
        with: r
        callback: #close
        reason: nil;
      _ -> self
        end: sock
        with: reason
        callback: #error
        reason: reason
    ]
    nil

  /// Run the closing callback, then close the socket. The callback's answer
  /// is ignored.
  end: sock :: Socket with: closeReason :: Object callback: which :: #timeout | #shutdown | #close | #error reason: reason :: Object -> Nil =>
    st := self.userState
    which match: [
      #timeout -> self handleTimeout: sock state: st;
      #shutdown -> self handleShutdown: sock state: st;
      #close -> self handleClose: sock state: st;
      _ -> self
        handleError: reason
        socket: sock
        state: st
    ]
    self close: sock reason: closeReason

  /// Close the socket and stop the connection span with the `getstat`
  /// counters and, unless `closeReason` is a clean one, `#error`
  /// (`do_socket_close/2`).
  close: sock :: Socket reason: closeReason :: Object -> Nil =>
    span := sock telemetrySpan
    stats := sock getstat
    sock close
    span isNil
      ifFalse: [
        counters := stats isOk ifTrue: [
          self counters: stats value
        ] ifFalse: [#{}]
        clean := #(#shutdown, #local_closed, #peer_closed) anySatisfy: [:r |
          r =:= closeReason
        ]
        span stopWith: counters metadata: (clean ifTrue: [
          #{}
        ] ifFalse: [#{#error => closeReason}])
      ]
    nil

  /// The `send_oct`, `send_cnt`, `recv_oct` and `recv_cnt` of a `getstat`
  /// answer.
  counters: stats :: List -> Dictionary =>
    result := #{}
    #(#send_oct, #send_cnt, #recv_oct, #recv_cnt)
      do: [:key |
        result := result at: key put: (Erlang proplists get_value: key with: stats)
      ]
    result
