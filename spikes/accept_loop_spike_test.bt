/// Spike 3 (PLAN.md Phase 0): a `Server` runs a blocking accept loop driven
/// by a self-message (`handleInfo: #accept` -> accept -> re-send `#accept`)
/// and still stops cleanly when its supervisor shuts it down, when the listen
/// socket closes (`{error, closed}`) and when it is killed mid-accept.
TestCase subclass: AcceptLoopSpikeTest

  listen =>
    ((Erlang gen_tcp) listen: 0 with: #(#binary, {#active, false}, {#reuseaddr, true})) unwrap

  supervise: acceptorClass socket: ls table: tableName shutdown: ms =>
    AcceptLoopSupervisor
      spawnWith: #{
        #acceptorClass => acceptorClass,
        #listenSocket => ls,
        #tableName => tableName,
        #shutdown => ms
      }

  connect: ls =>
    port := ((Erlang inet) port: ls) unwrap
    ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#active, false})) unwrap

  /// Poll the Ets table until `key` holds a value, for up to a second.
  await: key in: table =>
    100 timesRepeat: [(table at: key) isNil ifTrue: [Timer sleep: 10]]
    table at: key

  /// Poll until `pid` has exited, for up to `ms` milliseconds.
  awaitDeath: pid within: ms =>
    (ms div: 10) timesRepeat: [(self isAlive: pid) ifTrue: [Timer sleep: 10]]
    (self isAlive: pid) not

  isAlive: pid => (Erlang erlang) is_process_alive: pid

  now => Erlang erlang monotonic_time: #millisecond

  testAcceptLoopAcceptsRepeatedly =>
    table := Ets new: #acceptLoopRepeat type: #set
    ls := self listen
    sup := self
      supervise: AcceptLoop
      socket: ls
      table: #acceptLoopRepeat
      shutdown: 5000
    c1 := self connect: ls
    c2 := self connect: ls
    c3 := self connect: ls
    50 timesRepeat: [(table at: #accepted) =:= 3 ifFalse: [Timer sleep: 10]]
    self assert: (table at: #accepted) equals: 3
    sup stop
    #(c1, c2, c3) do: [:c | (Erlang gen_tcp) close: c]
    (Erlang gen_tcp) close: ls
    table delete

  testSupervisorShutdownStopsBlockedAcceptor =>
    table := Ets new: #acceptLoopShutdown type: #set
    ls := self listen
    sup := self
      supervise: AcceptLoop
      socket: ls
      table: #acceptLoopShutdown
      shutdown: 5000
    pid := self await: #pid in: table
    // Let it block in accept.
    Timer sleep: 50
    started := self now
    (sup terminateChild: #acceptor) unwrap
    elapsed := self now - started
    self assert: (self awaitDeath: pid within: 100)
    // Well under the 5 s shutdown timeout: the shutdown exit killed it.
    self assert: elapsed < 1000
    self assert: (sup whichChildren first status) equals: #stopped
    sup stop
    (Erlang gen_tcp) close: ls
    table delete

  testSupervisorStopStopsBlockedAcceptor =>
    table := Ets new: #acceptLoopSupStop type: #set
    ls := self listen
    sup := self
      supervise: AcceptLoop
      socket: ls
      table: #acceptLoopSupStop
      shutdown: 5000
    pid := self await: #pid in: table
    Timer sleep: 50
    started := self now
    sup stop
    self assert: self now - started < 1000
    self assert: (self awaitDeath: pid within: 100)
    (Erlang gen_tcp) close: ls
    table delete

  testTrappingAcceptorWaitsOutShutdownTimeout =>
    // The caveat: with terminate: overridden the actor traps exits, so the
    // shutdown sits in its mailbox behind the blocked accept. The
    // supervisor waits the full shutdown timeout, then kills it, and
    // terminate: never runs.
    table := Ets new: #acceptLoopTrapping type: #set
    ls := self listen
    sup := self
      supervise: TrappingAcceptLoop
      socket: ls
      table: #acceptLoopTrapping
      shutdown: 300
    pid := self await: #pid in: table
    Timer sleep: 50
    started := self now
    (sup terminateChild: #acceptor) unwrap
    elapsed := self now - started
    self assert: (self awaitDeath: pid within: 100)
    self assert: elapsed >= 300
    self assert: (table at: #terminateReason) equals: nil
    sup stop
    (Erlang gen_tcp) close: ls
    table delete

  testClosedListenSocketEndsAcceptorNormally =>
    table := Ets new: #acceptLoopClosed type: #set
    ls := self listen
    sup := self
      supervise: AcceptLoop
      socket: ls
      table: #acceptLoopClosed
      shutdown: 5000
    pid := self await: #pid in: table
    Timer sleep: 50
    (Erlang gen_tcp) close: ls
    self assert: (self await: #acceptError in: table) equals: #closed
    self assert: (self awaitDeath: pid within: 1000)
    // #transient and a normal exit: the supervisor does not restart it.
    Timer sleep: 100
    self assert: (sup whichChildren first status) equals: #stopped
    self assert: (table at: #pid) equals: pid
    self assert: sup isAlive
    sup stop
    table delete

  testKilledMidAcceptIsRestarted =>
    table := Ets new: #acceptLoopKilled type: #set
    ls := self listen
    sup := self
      supervise: AcceptLoop
      socket: ls
      table: #acceptLoopKilled
      shutdown: 5000
    pid := self await: #pid in: table
    Timer sleep: 50
    (Erlang erlang) exit: pid reason: #kill
    self assert: (self awaitDeath: pid within: 1000)
    // #transient and an abnormal exit: restarted, and the new one accepts.
    50 timesRepeat: [(table at: #pid) =:= pid ifTrue: [Timer sleep: 10]]
    newPid := table at: #pid
    self deny: newPid =:= pid
    self assert: (self isAlive: newPid)
    c := self connect: ls
    self assert: (self await: #accepted in: table) equals: 1
    sup stop
    (Erlang gen_tcp) close: c
    (Erlang gen_tcp) close: ls
    table delete
