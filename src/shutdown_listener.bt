/// ShutdownListener — stops the listener first when a server shuts down,
/// so acceptors stop accepting while connections drain, as Thousand
/// Island's `ThousandIsland.ShutdownListener`.
///
/// It is the server's last child, so the supervisor terminates it first.
/// It overrides `terminate:`, which makes it trap exits, so the shutdown
/// runs `terminate:`, which stops the listener. It finds the listener in a
/// `continueWith:` step after it has started, never while the server is
/// waiting on its start.
///
/// Args: `#server`, the `ServerSupervisor`. Restart: `#permanent`.
typed Actor subclass: ShutdownListener
  state: server :: ServerSupervisor
  // Acquired once by `attach`. A listener restart restarts this actor too
  // (`restForOne`), so the handle cannot go stale. Unset if the server shuts
  // down before `attach` ran; `terminate:` guards for that.
  late state: listener :: Listener

  class supervisionPolicy -> RestartStrategy => #permanent

  initialize -> Nil =>
    self continueWith: #attach
    nil

  attach -> Nil =>
    self.listener := self.server listener unwrap
    nil

  terminate: _reason :: Object -> Nil =>
    // `stop` is idempotent, so an already-stopped listener is fine.
    (self hasField: #listener) ifTrue: [self.listener stop]
    nil
