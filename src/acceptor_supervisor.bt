/// AcceptorSupervisor — one acceptor and the connections it has started,
/// as Thousand Island's `ThousandIsland.AcceptorSupervisor`. `restForOne`:
/// if the connection supervisor dies, the acceptor restarts with it.
///
/// Args: `#id`, `#server` and `#config`. The acceptor gets `#parent => self`
/// to find its `#connections` sibling.
///
/// ## Examples
/// ```beamtalk
/// accSup := srv acceptorSupervisors first
/// accSup whichChildren collect: [:c | c id]   // => #(#connections, #acceptor)
/// (accSup terminateChild: #acceptor) unwrap    // what `srv suspend` does
/// ```
typed Supervisor subclass: AcceptorSupervisor

  strategy -> SupervisionStrategy => #restForOne

  childSpecs -> List(SupervisionSpec) =>
    config :: ServerConfig := self args at: #config
    #((ConnectionSupervisor supervisionSpec withId: #connections withArgs: config), (Acceptor supervisionSpec
      withId: #acceptor
      withRestart: #transient
      withArgs: #{
        #id => (self args at: #id),
        #parent => self,
        #server => (self args at: #server),
        #config => config
      }))
