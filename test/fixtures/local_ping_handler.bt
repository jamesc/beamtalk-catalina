/// `ReadTimeout`: floods itself with local messages every 10 ms, which
/// must not reset the read timer.
RecordingHandler subclass: LocalPingHandler

  handleConnection: _sock :: Socket state: st :: Object -> HandlerResult =>
    self scheduleLocalPing
    HandlerResult continue: st

  handleData: _data :: Object socket: _sock :: Socket state: st :: Object -> HandlerResult =>
    self note: #ping
    HandlerResult continue: st

  handleUserInfo: msg :: Object -> Object =>
    msg =:= #localPing ifTrue: [self scheduleLocalPing]

  scheduleLocalPing -> Object =>
    Erlang erlang
      send_after: 10
      dest: self pid
      msg: #localPing
