/// Spike 4 (PLAN.md Phase 0): a ref-tagged `read_timeout` timer. Stale refs
/// are ignored, a newer deadline re-arms, and `#infinity` cancels, with no
/// mailbox flush. Timing margins are generous; the assertions are about
/// which messages counted, not exact times.
TestCase subclass: ReadTimeoutSpikeTest

  testTimerFiresOnce =>
    s := ReadTimeoutServer spawn
    s readTimeout: 20
    Timer sleep: 80
    self assert: s timeouts equals: 1
    self assert: s stale equals: 0
    self deny: s hasTimer
    s stop

  testStaleRefIsIgnored =>
    s := ReadTimeoutServer spawn
    Erlang erlang send: s pid msg: {#read_timeout, Erlang erlang make_ref}
    self assert: s stale equals: 1
    self assert: s timeouts equals: 0
    s stop

  testCancelledTimerThatAlreadyFiredIsStale =>
    s := ReadTimeoutServer spawn
    s armThenCancelAfterFiring
    // The fired message was already queued behind the call; it is handled
    // now and counted as stale instead of timing the connection out.
    self assert: s stale equals: 1
    self assert: s timeouts equals: 0
    s stop

  testInfinityCancels =>
    s := ReadTimeoutServer spawn
    s readTimeout: 30
    s readTimeout: #infinity
    Timer sleep: 80
    self assert: s timeouts equals: 0
    self assert: s stale equals: 0
    s stop

  testLaterDeadlineRearmsForTheRemainder =>
    s := ReadTimeoutServer spawn
    s readTimeout: 40
    // Later deadline: no new timer; the 40 ms one re-arms when it fires.
    s readTimeout: 150
    Timer sleep: 80
    self assert: s timeouts equals: 0
    self assert: s rearms equals: 1
    self assert: s hasTimer
    Timer sleep: 150
    self assert: s timeouts equals: 1
    self assert: s stale equals: 0
    s stop

  testEarlierDeadlineReplacesTheTimer =>
    s := ReadTimeoutServer spawn
    s readTimeout: 500
    s readTimeout: 20
    Timer sleep: 80
    self assert: s timeouts equals: 1
    // The 500 ms timer was cancelled before it fired, so nothing stale.
    Timer sleep: 500
    self assert: s timeouts equals: 1
    self assert: s stale equals: 0
    s stop
