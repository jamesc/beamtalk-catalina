/// `SyncReadTimeout`: a blocking `recv` inside the callback times out
/// after the read timeout, and the `#timeout` error is a read timeout.
RecordingHandler subclass: SyncReadTimeout

  handleData: _data :: Object socket: sock :: Socket state: st :: Object -> HandlerResult =>
    self note: #ping
    received := sock recv: 0
    received isError ifTrue: [
      HandlerResult error: received error state: st
    ] ifFalse: [HandlerResult continue: st]
