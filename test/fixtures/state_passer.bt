/// `StatePasser`: closes on "ping"; `handleClose:` records the state.
RecordingHandler subclass: StatePasser

  handleData: data :: Object socket: _sock :: Socket state: st :: Object -> HandlerResult =>
    (HandlerHarness textOf: data) =:= "ping" ifTrue: [
      HandlerResult close: st
    ] ifFalse: [HandlerResult continue: st]
