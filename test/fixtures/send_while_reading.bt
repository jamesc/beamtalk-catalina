/// `SendDoesNotAffectTimeout`: sends a byte every millisecond; sending
/// must not reset the read timer.
RecordingHandler subclass: SendWhileReading

  handleConnection: _sock :: Socket state: st :: Object -> HandlerResult =>
    Timer
      send: #sendBytes
      to: self
      after: 1
    HandlerResult continue: st

  handleUserInfo: msg :: Object -> Object =>
    msg =:= #sendBytes
      ifTrue: [
        self socket send: "A"
        Timer
          send: #sendBytes
          to: self
          after: 1
      ]
