/// Port of Thousand Island's `connection_test.exs`.
TestCase subclass: ConnectionTest

  testOwnershipTransferErrorClosesTheSocketAndTerminatesTheIdleHandler =>
    table := Ets new: #catalinaConnectionTest type: #set
    config := ServerConfig
      fromOptions: #{
        #handler => WaitingHandler,
        #handlerOptions => #catalinaConnectionTest,
        #shutdownTimeout => 1000
      }
    handlerConfig := (HandlerConfig fromServerConfig: config) withTransport: OwnershipErrorTransport
    connections := ConnectionSupervisor spawnWith: config
    rawSocket := {#catalinaConnectionTest, #badarg}
    result := Connection
      start: rawSocket
      connections: connections
      config: config
      handlerConfig: handlerConfig
      span: nil
      acceptor: Erlang erlang self
    self assert: result error equals: {#controlling_process, #badarg}
    handlerPid := table at: #started
    self assert: (table at: #controllingProcess) equals: handlerPid
    self assert: (table at: #closed) equals: true
    self assert: (table at: #terminated) equals: #shutdown
    self assert: (table at: #ready) equals: nil
    self deny: (self isAlive: handlerPid)
    self assert: connections children equals: #()
    connections stop
    table delete

  /// Not in Thousand Island (BT-4051): a handler whose acceptor dies
  /// between starting it and handing it the socket stops, rather than
  /// waiting for a ready message that never comes.
  testAHandlerWhoseAcceptorDiesBeforeTheHandoffStops =>
    config := ServerConfig fromOptions: #{#handler => EchoHandler}
    connections := ConnectionSupervisor spawnWith: config
    acceptor := (Erlang erlang) spawn: [Timer sleep: 60000]
    handler := (connections startChild: #{
      #handlerOptions => #(),
      #acceptor => acceptor
    }) unwrap
    self assert: (self isAlive: handler pid)
    (Erlang erlang) exit: acceptor with: #kill
    self waitUntilDead: handler pid
    self deny: (self isAlive: handler pid)
    self assert: connections children equals: #()
    connections stop

  isAlive: pid -> Boolean => (Erlang erlang) is_process_alive: pid

  /// Poll for up to 5 s: the machine may be loaded.
  waitUntilDead: pid =>
    deadline := (Erlang erlang monotonic_time: #millisecond) + 5000
    [
      (self isAlive: pid) and: [
        (Erlang erlang monotonic_time: #millisecond) < deadline
      ]
    ] whileTrue: [Timer sleep: 10]
    nil
