/// `LongHandlerCallbacksDoNotAffectTimeout`: a slow `handleData:` does not
/// eat into the read timeout, which starts when it returns.
RecordingHandler subclass: SlowDataCallback

  handleData: _data :: Object socket: _sock :: Socket state: st :: Object -> HandlerResult =>
    Timer sleep: 200
    Erlang erlang
      send_after: 50
      dest: self pid
      msg: #sendBytes
    HandlerResult continue: st

  handleUserInfo: msg :: Object -> Object =>
    msg =:= #sendBytes ifTrue: [self socket send: "A"]
