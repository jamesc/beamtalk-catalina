/// Spike 4: the lazy, ref-tagged read timer planned for `Handler`.
///
/// `readTimeout: ms` sets the read deadline. A timer is started only when
/// none is running or the new deadline is earlier than the running one's.
/// Each timer message is `{read_timeout, Ref}` with a fresh ref kept in
/// `timerRef`; a message whose ref is not the current one is stale and
/// ignored, so a cancelled timer that already fired needs no mailbox flush.
/// When the current timer fires before the deadline (the deadline moved
/// later) it re-arms for the remainder.
Server subclass: ReadTimeoutServer
  state: deadline = nil
  state: timerRef = nil
  state: timer = nil
  state: timerDeadline = nil
  state: timeouts = 0
  state: stale = 0
  state: rearms = 0

  readTimeout: ms =>
    ms =:= #infinity ifTrue: [self cancelTimer] ifFalse: [self extendTo: ms]
    #ok

  extendTo: ms =>
    now := self now
    self.deadline := now + ms
    (self.timerRef isNil or: [
      self.deadline < self.timerDeadline
    ]) ifTrue: [self armAt: self.deadline now: now]

  armAt: aDeadline now: now =>
    self.timer isNil ifFalse: [Erlang erlang cancel_timer: self.timer]
    ref := Erlang erlang make_ref
    self.timerRef := ref
    self.timerDeadline := aDeadline
    self.timer := Erlang erlang
      send_after: aDeadline - now
      dest: self pid
      msg: {#read_timeout, ref}

  cancelTimer =>
    self.timer isNil ifFalse: [Erlang erlang cancel_timer: self.timer]
    self.timer := nil
    self.timerRef := nil
    self.timerDeadline := nil
    self.deadline := nil

  /// The race a mailbox flush exists for: the timer fires while this
  /// message is still running, then is cancelled. Its message is already
  /// queued and arrives after the cancel.
  armThenCancelAfterFiring =>
    self readTimeout: 1
    Timer sleep: 30
    self readTimeout: #infinity
    #ok

  handleInfo: msg =>
    msg match: [
      {#read_timeout, ref} -> self onReadTimeout: ref;
      _ -> nil
    ]

  onReadTimeout: ref =>
    ref =:= self.timerRef ifTrue: [
      self onCurrentTimer
    ] ifFalse: [self.stale := self.stale + 1]

  onCurrentTimer =>
    now := self now
    self.timer := nil
    self.timerRef := nil
    now >= self.deadline
      ifTrue: [
        self.timeouts := self.timeouts + 1
        self.deadline := nil
        self.timerDeadline := nil
      ]
      ifFalse: [
        self.rearms := self.rearms + 1
        self armAt: self.deadline now: now
      ]

  now => Erlang erlang monotonic_time: #millisecond

  timeouts => self.timeouts

  stale => self.stale

  rearms => self.rearms

  hasTimer => self.timerRef notNil
